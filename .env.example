# survey-search 로컬 설정 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 로 커밋되지 않습니다.
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ 왜 커맨드라인 인자가 아니라 환경변수인가
#    이 서버는 /proc 에 hidepid 가 걸려 있지 않아, 다른 사용자가 `ps -eo args` 로
#    남의 명령줄을 그대로 볼 수 있습니다. /proc/<pid>/environ 은 소유자만 읽을 수
#    있으므로 환경변수가 안전합니다. (AutoSurvey/.env 의 같은 주의사항과 동일)

# ── LLM (S1 facet 분해에만 사용) ──────────────────────────────────────────────
#
# LLM 을 쓰는 곳은 파이프라인 전체에서 S1 하나뿐입니다. 토픽을 하위 주제 8~16개로
# 쪼개고 각 facet 마다 동의어·약어를 섞은 쿼리를 받습니다.
# 결과는 디스크에 캐시되므로 **같은 토픽 재실행은 호출 0회**입니다.
#
# 키가 없으면 S1 은 규칙 기반 fallback 으로 동작하고, 그 사실이 stats 에 남습니다
# (조용히 토픽 1쿼리로 되돌아가지 않습니다).

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# facet 분해용 모델. 사전 지식만 쓰는 짧은 구조화 출력이라 큰 모델이 필요 없습니다.
SURVEY_SEARCH_FACET_MODEL=deepseek/deepseek-v4-flash-0731

# ── 자산 경로 (기본값이 맞으면 설정할 필요 없습니다) ─────────────────────────────
#
# 1차 인덱스: SurveyForge 2026-08 스냅샷 (gte-large-en-v1.5, 1024d, 908,819편)
# SURVEY_SEARCH_SF_DB=/data2/chanjoong/survey-agent/SurveyForge_data/database_2026-08
#
# 우리가 만드는 산출물 (papers.duckdb, facet 캐시). .gitignore 대상
# SURVEY_SEARCH_DATA_DIR=/data2/chanjoong/survey-agent/survey-search/data

# 임베딩 모델 캐시. 기본값이 이미 받아져 있습니다
# HF_HOME=/data2/chanjoong/.cache/huggingface

# ── GPU ─────────────────────────────────────────────────────────────────────
#
# 쿼리 임베딩에만 씁니다(검색 자체는 CPU FAISS). 긴 작업 전에 nvidia-smi 로
# 점유 상황을 다시 확인하세요 — 시간대에 따라 크게 바뀝니다.
# CUDA_VISIBLE_DEVICES=1

# FAISS 브루트포스 스캔의 스레드 수. 64코어 머신에서 16이면 충분합니다.
OMP_NUM_THREADS=16
